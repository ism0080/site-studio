{
  "name": "site-studio",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun --cwd packages/api node_modules/alchemy/bin/alchemy.ts dev --env-file .env",
    "dev:web": "bun run --filter @site-studio/web dev",
    "dev:api": "bun run --filter @site-studio/api dev",
    "build:web": "bun run --filter @site-studio/web build",
    "build:template": "bun run --filter @site-studio/site-template build",
    "check:api": "bun run --filter @site-studio/api typecheck",
    "check:template": "bun run --filter @site-studio/site-template typecheck",
    "check:web": "bun run --filter @site-studio/web typecheck",
    "test": "bun run --filter @site-studio/api test",
    "test:api": "bun run --filter @site-studio/api smoke",
    "lint": "bun run lint:component-css && oxlint",
    "lint:component-css": "bun tools/validate-component-css-nesting.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "oxfmt": "^0.62.0",
    "oxlint": "1.78.0"
  },
  "overrides": {
    "@effect/platform-bun": "4.0.0-beta.103",
    "@effect/platform-node": "4.0.0-beta.103",
    "effect": "4.0.0-beta.103"
  }
}
