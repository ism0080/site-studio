{
  "name": "site-studio",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun run --filter @site-studio/web dev",
    "dev:api": "bun run --filter @site-studio/api dev",
    "build:web": "bun run --filter @site-studio/web build",
    "build:template": "bun run --filter @site-studio/site-template build",
    "check:api": "bun run --filter @site-studio/api typecheck",
    "check:template": "bun run --filter @site-studio/site-template check",
    "test:api": "bun run --filter @site-studio/api smoke"
  },
  "overrides": {
    "effect": "4.0.0-beta.103",
    "@effect/platform-bun": "4.0.0-beta.103",
    "@effect/platform-node": "4.0.0-beta.103"
  }
}
