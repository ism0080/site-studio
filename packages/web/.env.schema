# @generateTsTypes(path=./env.d.ts)
# @defaultSensitive=inferFromPrefix('VITE_')
# ---
# Site Studio web environment schema.
#
# VITE_ prefixed items are bundled for the browser, so they are non-sensitive.
# Values live in the git-ignored .env; this file is the committed source of truth.

# API origin. Vite dev proxies /api to this URL to keep the frontend and API
# same-origin so session cookies work.
# @type=url
VITE_API_URL=http://localhost:8787

# Run the app against in-browser mocked API responses (src/mocks) instead of
# the real API, so it runs without the backend. Leave unset to disable.
# @optional
# @type=boolean
VITE_MOCK_API=

# Override only when the API is NOT same-origin as the frontend (no proxy).
# @optional
# @type=url
VITE_AUTH_URL=

# Public www worker base URL used to build "View live site" links.
# @type=url
VITE_WWW_URL=http://localhost:8788
