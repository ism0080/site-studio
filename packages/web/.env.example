# Frontend -> API wiring. The API is served by packages/api (alchemy dev/deploy)
# under /api (auth: /api/auth, sites: /api/sites). In dev the Vite server proxies
# /api to VITE_API_URL, keeping the frontend and API same-origin so session
# cookies work. Copy to .env and set the values you need.
VITE_API_URL=http://localhost:8787
# Override only if the API is NOT same-origin as the frontend (no proxy).
# VITE_AUTH_URL=http://localhost:8787
# Public www worker base URL used to build "View live site" links.
VITE_WWW_URL=http://localhost:8788
