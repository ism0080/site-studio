{
  "name": "@site-studio/site-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/render.tsx",
      "bun": "./src/render.tsx",
      "node": "./dist/render.mjs",
      "default": "./dist/render.mjs"
    },
    "./templates": "./src/templates.ts"
  },
  "scripts": {
    "build": "bun build ./src/render.tsx --outfile ./dist/render.mjs --external react --external react-dom --external react/jsx-runtime --external react/jsx-dev-runtime --format esm --target node",
    "render": "bun run scripts/render.mjs",
    "publish": "bun run scripts/publish.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.3"
  }
}
