---
import type { ServicesProps } from "../../site.ts"

const { props, layout } = Astro.props as { props: ServicesProps; layout: string }
const mod = layout === "warm" ? " warm" : layout === "grid" ? " grid" : ""
---

<section class={`services${mod}`}>
  <h2>{props.title}</h2>
  <div class="grid">
    {
      props.items.map((item) => (
        <article class="card">
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 1rem;
    padding: 1.5rem;
  }
  h3 {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
  }
  p {
    margin: 0;
  }

  /* Warm: centered heading, softer rounded cards. */
  .services.warm h2 {
    text-align: center;
  }
  .services.warm .card {
    border-radius: 1.5rem;
    padding: 2rem;
    text-align: center;
  }

  /* Grid: bordered cells, no fill. */
  .services.grid h2 {
    font-size: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .services.grid .card {
    background: transparent;
    border-radius: 0;
    border-width: 1px;
  }
  .services.grid h3 {
    text-transform: uppercase;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
  }
</style>
