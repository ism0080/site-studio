---
import type { AboutProps } from "../../site.ts"

interface Props {
  props: AboutProps
  layout: string
}

const { props, layout } = Astro.props
const mod = layout === "warm" ? " warm" : layout === "grid" ? " grid" : ""
---

<section class={`about${mod}`}>
  {props.eyebrow && <p class="eyebrow">{props.eyebrow}</p>}
  <h2>{props.title}</h2>
  <p class="body">{props.body}</p>
</section>

<style>
  max-width: 40rem;
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--accent);
    margin: 0 0 0.5rem;
  }
  h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }
  .body {
    font-size: 1.1rem;
    line-height: 1.7;
    margin: 0;
  }

  /* Warm: centered, serif-friendly. */
  .about.warm {
    max-width: 34rem;
    margin: 0 auto;
    text-align: center;
  }

  /* Grid: split title / body columns. */
  .about.grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 3rem;
    max-width: 100%;
    align-items: start;
  }
  .about.grid .eyebrow {
    grid-column: 1 / -1;
  }
  .about.grid .body {
    font-size: 1rem;
  }
</style>
