---
import type { AboutProps } from "../../site.ts"

const { props } = Astro.props as { props: AboutProps }
---

<section class="about">
  {props.eyebrow && <p class="eyebrow">{props.eyebrow}</p>}
  <h2>{props.title}</h2>
  <p class="body">{props.body}</p>
</section>

<style>
  max-width: 40rem;
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--accent);
    margin: 0 0 0.5rem;
  }
  h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }
  .body {
    font-size: 1.1rem;
    line-height: 1.7;
    margin: 0;
  }
</style>
