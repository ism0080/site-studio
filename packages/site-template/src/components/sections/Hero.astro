---
import type { HeroProps } from "../../site.ts"

const { props, layout } = Astro.props as { props: HeroProps; layout: string }
const mod = layout === "warm" ? " warm" : layout === "grid" ? " grid" : ""
---

<section class={`hero${mod}`}>
  {props.eyebrow && <p class="eyebrow">{props.eyebrow}</p>}
  <h1>{props.headline}</h1>
  <p class="lede">{props.description}</p>
  <div class="cta-row">
    <a class="cta-primary" href="#contact">{props.primaryCta}</a>
    {props.secondaryCta && (
      <a class="cta-secondary" href="#contact">{props.secondaryCta}</a>
    )}
  </div>
  {props.image && <img class="hero-image" src={props.image} alt="" loading="eager" />}
</section>

<style>
  .hero {
    display: grid;
    gap: 1rem;
    max-width: 46rem;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--accent);
    margin: 0;
  }
  h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .lede {
    font-size: 1.15rem;
    max-width: 36rem;
    margin: 0;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .cta-primary,
  .cta-secondary {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
  }
  .cta-primary {
    background: var(--accent);
    color: #fff;
  }
  .cta-secondary {
    border: 1px solid currentColor;
  }
  .hero-image {
    width: 100%;
    max-height: 28rem;
    object-fit: cover;
    border-radius: 1.25rem;
    margin-top: 1.5rem;
  }

  /* Warm: centered, softer, image as a full-width banner. */
  .hero.warm {
    max-width: 40rem;
    justify-items: center;
    text-align: center;
    margin: 0 auto;
  }
  .hero.warm h1 {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .hero.warm .lede {
    max-width: 30rem;
  }
  .hero.warm .cta-row {
    justify-content: center;
  }
  .hero.warm .hero-image {
    max-height: 24rem;
    border-radius: 2rem;
  }

  /* Grid: tighter, image framed. */
  .hero.grid {
    max-width: 100%;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 3rem;
  }
  .hero.grid h1 {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    letter-spacing: -0.03em;
  }
  .hero.grid .hero-image {
    max-height: 22rem;
    border-radius: 0.75rem;
    border: 1px solid var(--border);
    margin-top: 0;
  }
</style>
