---
import type { TestimonialsProps } from "../../site.ts"

const { props } = Astro.props as { props: TestimonialsProps }
---

<section class="testimonials">
  <h2>{props.title}</h2>
  <div class="grid">
    {
      props.items.map((item) => (
        <blockquote class="card">
          <p class="quote">“{item.quote}”</p>
          <footer>
            <span class="author">{item.author}</span>
            <span class="role">{item.role}</span>
          </footer>
        </blockquote>
      ))
    }
  </div>
</section>

<style>
  h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 1rem;
    padding: 1.5rem;
    margin: 0;
  }
  .quote {
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0 0 1rem;
  }
  footer {
    display: grid;
    gap: 0.15rem;
    font-size: 0.9rem;
  }
  .author {
    font-weight: 700;
  }
  .role {
    color: var(--muted);
  }
</style>
