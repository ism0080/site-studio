# @plugin(@varlock/1password-plugin)
# @initOp(allowAppAuth=true, account=AH7HQ5FEBJBHJHVXU5EUYKWJNQ)
# @setValuesBulk(opLoadEnvironment(ginkjl4xvh4tfbbk5vlib7ytkm))
# @defaultSensitive=false
# @defaultRequired=false
#
# Site Studio API environment schema.
#
# Declares and validates the config read by the api/www/build workers and the
# Alchemy deploy entrypoint. Values live in the git-ignored .env; this file is
# the committed source of truth.
#
# Secrets are marked @sensitive so varlock redacts them in logs and CLI output.
# Deploy-only items are left optional here because local dev runs without them.

# --- Auth (Better Auth) ---

# Required. Better Auth signing secret (>= 32 chars); the worker fails to start
# when it is missing. Generate with: openssl rand -hex 32
# @sensitive
# @type=string(minLength=32)
AUTH_SECRET=

# Public base URL of the api worker, also the Google OAuth redirect base.
# @type=url
AUTH_BASE_URL=http://localhost:8787

# Comma-separated list of origins allowed to call the API.
# @type=array(url)
TRUSTED_ORIGINS=http://localhost:5173

# Google OAuth app credentials.
# @docs(https://console.cloud.google.com/apis/credentials)
# @sensitive
GOOGLE_CLIENT_ID=
# @sensitive
GOOGLE_CLIENT_SECRET=

# Comma-separated emails granted the platform admin role.
# @type=array(email)
ADMIN_EMAILS=

# --- Cloudflare for SaaS custom hostnames ---
# Required to attach customer domains. The API token needs Custom Hostnames
# write/read on the SaaS zone.
# @docs(https://developers.cloudflare.com/cloudflare-for-platforms/cloudflare-for-saas/)
CF_SAAS_ZONE_ID=
# @sensitive
CF_API_TOKEN=
# @type=domain
CF_SAAS_CNAME_TARGET=customers.site-studio.dev

# --- www worker / edge cache ---

# Custom domain attached to the www worker (e.g. sites.site-studio.dev).
# Reserved site subdomains are served as *.<WWW_DOMAIN>, so this is also read
# by the www worker at runtime (host routing) and the build worker (cache
# purge).
# @type=domain
WWW_DOMAIN=

# Purge reuses the SaaS zone (the zone serving the www domain and site
# subdomains); purge is skipped when CF_SAAS_ZONE_ID or CF_API_TOKEN is unset.

# Edge cache TTL in seconds for published sites.
# @type=number(isInt=true, min=0)
CACHE_MAX_AGE=3600

# --- Lead notification email (optional) ---
# Cloudflare send_email only delivers to verified destination addresses, so
# these are platform inboxes. Notifications are skipped when unset.
# @type=email
LEADS_NOTIFY_EMAIL=
# @type=email
LEADS_FROM_EMAIL=

# --- Build runner ---
# The build worker renders the site document in-process (site-template) and
# writes the pages to the Sites bucket. PUBLIC_API_URL is baked into the
# published contact form.
# @type=url
PUBLIC_API_URL=https://api.site-studio.dev

# --- Stripe billing (optional) ---
# Leave all three unset for Free-only mode: Free plans and billing status work,
# but checkout/portal return 503 BillingNotConfigured and the webhook rejects.
# Set all three to sell the Pro plan.
# @sensitive
STRIPE_API_KEY=
# Buyer-facing Pro monthly price id (price_...).
STRIPE_PRICE_ID=
# Webhook signing secret (whsec_...). Endpoint: /api/billing/webhook
# @sensitive
STRIPE_WEBHOOK_SECRET=

# --- Transactional email (Resend) ---
# Invite emails go through Resend. Leave RESEND_API_KEY unset to store invites
# without sending mail (the local/dev behavior).
# @sensitive
# @docs(https://resend.com/api-keys)
RESEND_API_KEY=
# Verified sender; the domain in this address must be verified in Resend.
EMAIL_FROM="Site Studio <no-reply@site-studio.dev>"
# Web app origin used for invite links.
# @type=url
WEB_URL=http://localhost:5173
