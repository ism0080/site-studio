# @plugin(@varlock/1password-plugin)
# @initOp(allowAppAuth=true, account=AH7HQ5FEBJBHJHVXU5EUYKWJNQ)
# @setValuesBulk(opLoadEnvironment(ginkjl4xvh4tfbbk5vlib7ytkm))
# @defaultSensitive=false
# @defaultRequired=false
#
# Site Studio API environment schema.
#
# Declares and validates the config read by the api/www/build workers, the
# Alchemy deploy entrypoint, and the build-runner scripts. Values live in the
# git-ignored .env; this file is the committed source of truth.
#
# Secrets are marked @sensitive so varlock redacts them in logs and CLI output.
# Deploy-only items are left optional here because local dev runs without them.

# --- Auth (Better Auth) ---

# Better Auth signing secret (>= 32 chars). Generate with: openssl rand -base64 32
# @sensitive
# @type=string(minLength=32)
AUTH_SECRET=

# Public base URL of the api worker, also the Google OAuth redirect base.
# @type=url
AUTH_BASE_URL=http://localhost:8787

# Comma-separated list of origins allowed to call the API.
# @type=array(url)
TRUSTED_ORIGINS=http://localhost:5173

# Google OAuth app credentials.
# @docs(https://console.cloud.google.com/apis/credentials)
# @sensitive
GOOGLE_CLIENT_ID=
# @sensitive
GOOGLE_CLIENT_SECRET=

# Comma-separated emails granted the platform admin role.
# @type=array(email)
ADMIN_EMAILS=

# --- Cloudflare for SaaS custom hostnames ---
# Required to attach customer domains. The API token needs Custom Hostnames
# write/read on the SaaS zone.
# @docs(https://developers.cloudflare.com/cloudflare-for-platforms/cloudflare-for-saas/)
CF_SAAS_ZONE_ID=
# @sensitive
CF_API_TOKEN=
# @type=domain
CF_SAAS_CNAME_TARGET=customers.site-studio.dev

# --- www worker / edge cache ---

# Custom domain attached to the www worker (e.g. sites.site-studio.dev).
# @type=domain
WWW_DOMAIN=

# Edge cache TTL in seconds for published sites.
# @type=number(isInt=true, min=0)
CACHE_MAX_AGE=3600

# --- Lead notification email (optional) ---
# Cloudflare send_email only delivers to verified destination addresses, so
# these are platform inboxes. Notifications are skipped when unset.
# @type=email
LEADS_NOTIFY_EMAIL=
# @type=email
LEADS_FROM_EMAIL=

# --- Build runner ---
# daytona (default): ephemeral Daytona sandbox
# local: runs the site-template publish.mjs on this host
# @type=enum(daytona, local)
BUILD_RUNNER=daytona

# Daytona renders the site document + uploads to R2 in an ephemeral sandbox.
# Without DAYTONA_API_KEY builds fall back to a no-op that reports failure.
# @sensitive
DAYTONA_API_KEY=
# @type=url
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_SNAPSHOT=site-template
DAYTONA_IMAGE=
DAYTONA_REPO_DIR=/home/daytona/site-template
# @type=number(isInt=true, min=1)
DAYTONA_CPU=2
# @type=number(isInt=true, min=1)
DAYTONA_MEMORY=2

# Local runner only: path to the site-template package.
SITE_TEMPLATE_DIR=../site-template

# --- R2 upload (passed to the build runner) ---
# Omit to skip the upload step (dry run).
# @type=url
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
# @sensitive
R2_SECRET_ACCESS_KEY=
# @type=url
PUBLIC_API_URL=https://api.site-studio.dev
