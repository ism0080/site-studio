# Read by the api worker (effect/Config) at deploy/dev time.
# Generate AUTH_SECRET with: openssl rand -base64 32

# Better Auth signing secret (>= 32 chars).
AUTH_SECRET=

# Public URL of the api worker (also the Google OAuth redirect base).
AUTH_BASE_URL=http://localhost:8787

# Comma-separated origins allowed to call the API (your frontend).
TRUSTED_ORIGINS=http://localhost:5173

# Google OAuth app (https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI: <AUTH_BASE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Lead notification email (optional). Cloudflare's send_email binding only
# delivers to verified destination addresses, so this is a platform inbox, not
# the site owner's address. Requires Email Routing on the zone + verified
# destination. When unset, lead notifications are skipped.
# LEADS_NOTIFY_EMAIL=hello@site-studio.dev
# LEADS_FROM_EMAIL=no-reply@site-studio.dev

# --- Build runner (build queue consumer + scripts/build-publish.ts) ---
# Publishing stores the site document and enqueues a build job; the `build`
# worker consumes it and runs the static build via Daytona. Set DAYTONA_API_KEY
# to enable builds; without it builds no-op and sites report "build failed".
#
#   BUILD_RUNNER=daytona  (default) Daytona sandbox build
#   BUILD_RUNNER=local    scripts/build-runner/local.ts (runs publish.mjs here)

# Daytona (runs `astro build` + R2 upload in an ephemeral sandbox).
# Create a sandbox with the site-template repo (deps installed) + bun, snapshot
# it, then set DAYTONA_SNAPSHOT to that snapshot's name.
DAYTONA_API_KEY=
# DAYTONA_API_URL=https://api.daytona.io
DAYTONA_SNAPSHOT=site-template
# DAYTONA_IMAGE=debian:12.9
# DAYTONA_REPO_DIR=/home/daytona/site-template
DAYTONA_CPU=2
DAYTONA_MEMORY=2

# Local runner (BUILD_RUNNER=local) — where the site-template repo lives.
# SITE_TEMPLATE_DIR=../site-template

# R2 credentials passed to the build runner for the upload step (same as the
# site-template publish.mjs uses). Omit for a dry run.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
PUBLIC_API_URL=https://api.site-studio.dev
